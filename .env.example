# Required
ANTHROPIC_API_KEY=

# Optional: model per stage ("provider:model"). Defaults to claude-opus-5 everywhere.
# MODEL_DEFAULT=anthropic:claude-opus-5
# MODEL_CRITIQUE=anthropic:claude-sonnet-5

# Optional: Langfuse tracing. On only when all three are set.
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_TRACING_ENVIRONMENT=dev

# Optional: total USD allowed on live runs, across all users (unset = no limit).
# On Vercel, add Upstash Redis from the Marketplace so the total is shared by every
# instance (it sets KV_REST_API_URL / KV_REST_API_TOKEN); without it, each instance counts alone.
# SPEND_LIMIT_USD=20
